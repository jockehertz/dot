{ 
  "layer": "top", 
  "position": "top", 
  "height": 40,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "network",
    "bluetooth",
    "battery"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "○",
      "active": "●"
    },
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },
  "clock": {
    "on-click": "proton-mail"
  },

  "network": {
    "format-wifi": "   ↑ {bandwidthUpBytes} ↓ {bandwidthDownBytes}",
    "tooltip-format-wifi": "  {essid} ({signalStrength}%) IPv4: {ipaddr}",
    "format-ethernet": "Wired: ↑ {bandwidthUpBytes} ↓ {bandwidthDownBytes}",
    "tooltip-format-ethernet": "Wired: {essid} ({signalStrength}%)",
    "format-linked": "Connecting...",
    "format-disconnected": " × Offline",
    "max-length": 50,
    "interval": 1,
    "on-click": "ghostty -e impala-nm +new-window"
  },
  "bluetooth": {
    "format-on": " ON",
    "format-off": " OFF",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} ({device_battery_percentage}%)",
    "on-click": "ghostty -e bluetui +new-window"
  },
  "battery": {
    "states": {
      "full": 100,
      "threequarters": 75,
      "half": 50,
      "warning": 25,
      "critical": 10
    },
    "format-full": " {capacity}%",
    "format-threequarters": " {capacity}%",
    "format-half": " {capacity}%",
    "format-warning": " {capacity}%",
    "format-critical": " {capacity}%",
    "format-charging": " charging: {capacity}%",
    "interval": 1
  }
}
